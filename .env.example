# =======================================================
# SmartFit Environment Variables Example / Template
# =======================================================

# ----------------- Frontend (Vite) ---------------------
# Base URL for Express Node.js Backend API
VITE_API_BASE_URL=http://localhost:8081/api

# Base URL for Admin endpoints
VITE_ADMIN_API_BASE_URL=http://localhost:8081/api/admin

# Base URL for Python FastAPI ML Microservice
VITE_ML_SERVICE_URL=http://localhost:8000

# ----------------- Backend (Express) -------------------
# Backend HTTP Port (dynamically assigned by Render in production)
PORT=8081

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.iimcb7m.mongodb.net/smartfit_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# ML Service URLs
FASTAPI_ML_URL=http://localhost:8000/predict/workout
ML_SERVICE_URL=http://localhost:8000
