# SmartFit Backend Environment Configuration Template
# Copy this file to .env and fill in your values

# Port for Express Backend (Render sets this dynamically via process.env.PORT)
PORT=8081

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.iimcb7m.mongodb.net/smartfit_db?retryWrites=true&w=majority

# Secret key for JWT Token signing and verification
JWT_SECRET=your_jwt_secret_key_here

# Python FastAPI ML Recommendation Service URLs
FASTAPI_ML_URL=http://localhost:8000/predict/workout
ML_SERVICE_URL=http://localhost:8000
